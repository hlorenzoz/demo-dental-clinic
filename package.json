  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "opennextjs-cloudflare build && cp -r .open-next/assets/* .open-next/ && (mv .open-next/worker.js .open-next/_worker.js 2>/dev/null || true) && echo '{\"version\":1,\"include\":[\"/*\"],\"exclude\":[\"/_next/static/*\",\"/favicon.ico\",\"/*.svg\",\"/*.js\",\"/*.json\",\"/icons/*\",\"/fonts/*\",\"/BUILD_ID\"]}' > .open-next/_routes.json",
    "deploy:pages": "rm -f wrangler.jsonc wrangler.toml && npx wrangler pages deploy .open-next --project-name template-website-dental-minimalist-teal --compatibility-date 2026-03-22 --compatibility-flag nodejs_compat",
    "preview": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
